<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ui_accent_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#17343D</item>
        <item name="android:statusBarColor">@color/ui_background_light</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/ui_background_light</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="AppThemeDarkBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ui_accent_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/ui_background_dark</item>
        <item name="android:statusBarColor">@color/ui_background_dark</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/ui_background_dark</item>
    </style>
    <style name="AppThemeDark" parent="AppThemeDarkBase" />
    <string name="setting_value">%1$s: %2$d</string>
</resources>
