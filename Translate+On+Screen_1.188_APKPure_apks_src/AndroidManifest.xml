    <!-- للسماح للتطبيق بإنشاء مقابس شبكات واستخدام بروتوكولات شبكات مخصصة. ويوفر المتصفح وتطبيقات أخرى طرقًا لإرسال البيانات إلى الإنترنت، ولذلك لا يعد هذا الإذن مطلوبًا لإرسال البيانات إلى الإنترنت. -->
    <uses-permission
        android:name="android.permission.INTERNET" />
    <!-- للسماح للتطبيق بعرض معلومات حول اتصالات الشبكة كعرض معلومات عن الشبكات المتوفرة والشبكات المتصلة. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- يمكن لهذا التطبيق الظهور في مقدمة التطبيقات أو أجزاء الشاشة الأخرى. وقد يتداخل هذا مع الاستخدام العادي للتطبيقات أو يؤدي إلى تغيير طريقة ظهور التطبيقات الأخرى. -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- للسماح للتطبيق بالاستفادة من الخدمات التي تعمل في المقدمة. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ‏يسمح هذا الإذن للتطبيق بالاستفادة من الخدمات التي تعمل في المقدّمة ذات النوع "mediaProjection". -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- للسماح للمستخدم بشراء العناصر عبر Google Play من داخل هذا التطبيق. -->
    <uses-permission
        android:name="com.android.vending.BILLING" />
    <!-- السماح للتطبيق بعرض إشعارات -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- يسمح هذا الإذن لتطبيق الناشر بالوصول إلى معرِّف إعلاني صالح بطريقة مباشرة أو غير مباشرة. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID" />
    <!-- يمكن لهذا التطبيق تسجيل الصوت باستخدام الميكروفون عندما يكون التطبيق قيد الاستخدام. -->
    <uses-permission
