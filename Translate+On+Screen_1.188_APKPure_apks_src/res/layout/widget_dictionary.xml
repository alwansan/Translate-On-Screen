<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/dialog_suggest_app_ll_root"
    android:background="@color/black_20"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@id/dialog_choose_v_outside"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/dialog_bottom_container"
        android:background="@drawable/bg_radius_gray_plus"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="4.0">
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:theme="@style/fontBold"
                android:textSize="22.0dip"
                android:textColor="@color/cl_text_word"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@id/dialog_choose_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20.0dip"
                android:layout_marginTop="20.0dip"
                android:layout_marginRight="70.0dip"
                android:layout_marginBottom="10.0dip"
                android:text="@string/dictionary"
                android:includeFontPadding="false"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true" />
            <ImageView
                android:id="@id/dialog_choose_tv_close"
                android:padding="9.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:layout_marginTop="8.0dip"
                android:layout_marginRight="8.0dip"
                android:foreground="@drawable/fg_efftect_circle"
                android:src="@drawable/ic_close_gray"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/dialog_choose_rv"
                android:clipToPadding="false"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginLeft="13.0dip"
                android:layout_marginRight="13.0dip"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/layout_result_detail_ll_loading"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ProgressBar
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:indeterminateDrawable="@drawable/progress" />
                <TextView
                    android:theme="@style/fontSemi"
                    android:textSize="18.0dip"
                    android:textColor="@color/cl_text_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loading_dictionary" />
            </LinearLayout>
            <TextView
                android:theme="@style/fontSemi"
                android:textSize="18.0dip"
                android:textColor="@color/cl_text_word"
                android:id="@id/layout_result_detail_tv_no_result"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_result"
                android:layout_centerInParent="true" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>