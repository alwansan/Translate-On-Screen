<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_gravity="center"
    android:id="@id/dialog_suggest_app_ll_root"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="20.0dip"
    android:layout_marginTop="5.0dip"
    android:layout_marginRight="20.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.core.widget.NestedScrollView
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_center"
        android:paddingTop="5.0dip"
        android:paddingBottom="25.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <TextView
                android:theme="@style/fontBold"
                android:textSize="22.0dip"
                android:textColor="@color/cl_text_word"
                android:gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15.0dip"
                android:layout_marginTop="10.0dip"
                android:layout_marginRight="15.0dip"
                android:text="@string/tutorial" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="15.0dip"
                android:paddingRight="15.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@id/dialog_info_container_video"
                    android:background="@drawable/bg_round_9_gray"
                    android:padding="5.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="400.0dip">
                    <androidx.media3.ui.PlayerView
                        android:id="@id/dialog_info_playerView"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        app:resize_mode="fit"
                        app:surface_type="texture_view"
                        app:use_controller="false" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:id="@id/dialog_tutorial_iv_close"
        android:padding="9.0dip"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="40.0dip"
        android:layout_height="40.0dip"
        android:layout_marginRight="5.0dip"
        android:foreground="@drawable/fg_efftect_circle"
        android:src="@drawable/ic_close_gray"
        android:layout_alignParentEnd="true" />
</RelativeLayout>