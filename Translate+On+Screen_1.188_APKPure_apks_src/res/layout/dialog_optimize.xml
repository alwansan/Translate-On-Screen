<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/rootView"
    android:background="@color/cl_background_white_black"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="70.0dip">
        <TextView
            android:theme="@style/fontBold"
            android:textSize="19.0dip"
            android:textColor="@color/cl_text_word"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginLeft="40.0dip"
            android:layout_marginRight="20.0dip"
            android:text="@string/fix_icon" />
        <ImageView
            android:gravity="center"
            android:id="@id/dialog_setting_auto_iv_close"
            android:padding="10.0dip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_marginLeft="8.0dip"
            android:layout_marginTop="10.0dip"
            android:foreground="@drawable/fg_efftect_circle"
            android:src="@drawable/ic_back_s"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true" />
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:background="@color/cl_background_grayW_black"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="10.0dip"
            android:paddingRight="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="15.0dip">
            <LinearLayout
                android:gravity="start|center"
                android:orientation="horizontal"
                android:id="@id/dialog_optimize_battery"
                android:background="@drawable/bg_round_12"
                android:paddingLeft="15.0dip"
                android:paddingTop="10.0dip"
                android:paddingRight="15.0dip"
                android:paddingBottom="10.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:foreground="@drawable/fg_efftect_12">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:gravity="center|left"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="35.0dip"
                            android:layout_height="35.0dip"
                            android:layout_marginRight="10.0dip"
                            android:src="@drawable/ic_battery_svg" />
                        <TextView
                            android:theme="@style/fontSemi"
                            android:textSize="19.0dip"
                            android:textColor="@color/cl_text_word"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/battery_title"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <TextView
                        android:textSize="15.0dip"
                        android:textColor="@color/cl_text_word"
                        android:id="@id/dialog_voice_tv_voice_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8.0dip"
                        android:layout_marginTop="8.0dip"
                        android:text="@string/battery_detail"
                        android:lineSpacingExtra="2.0dip" />
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="left"
                        android:orientation="horizontal"
                        android:id="@id/dialog_optimize_ll_battery_tutorial"
                        android:background="@drawable/bg_item_play"
                        android:paddingLeft="10.0dip"
                        android:paddingRight="10.0dip"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:foreground="@drawable/fg_efftect_12"
                        android:backgroundTint="#1a2f80ed">
                        <ImageView
                            android:layout_width="14.0dip"
                            android:layout_height="14.0dip"
                            android:src="@drawable/ic_play_tutorial"
                            android:alpha="0.8"
                            app:tint="#ff2f80ed" />
                        <TextView
                            android:theme="@style/fontSemi"
                            android:textSize="14.0dip"
                            android:textColor="#ff2f80ed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5.0dip"
                            android:text="@string/watch_tutorial"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:padding="2.0dip"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:src="@drawable/ic_more_down"
                    android:rotation="-90.0" />
            </LinearLayout>
            <LinearLayout
                android:gravity="start|center"
                android:orientation="horizontal"
                android:id="@id/dialog_optimize_lockapp"
                android:background="@drawable/bg_round_12"
                android:paddingLeft="15.0dip"
                android:paddingTop="10.0dip"
                android:paddingRight="15.0dip"
                android:paddingBottom="10.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                android:foreground="@drawable/fg_efftect_12">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:gravity="center|left"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="35.0dip"
                            android:layout_height="35.0dip"
                            android:layout_marginRight="10.0dip"
                            android:src="@drawable/ic_lockapp_svg" />
                        <TextView
                            android:theme="@style/fontSemi"
                            android:textSize="19.0dip"
                            android:textColor="@color/cl_text_word"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lockapp_title"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <TextView
                        android:textSize="15.0dip"
                        android:textColor="@color/cl_text_word"
                        android:id="@id/dialog_optimize_tv_lockapp_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8.0dip"
                        android:layout_marginTop="8.0dip"
                        android:text="@string/lockapp_detail_xiaomi"
                        android:lineSpacingExtra="2.0dip" />
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="left"
                        android:orientation="horizontal"
                        android:id="@id/dialog_optimize_ll_lockapp_tutorial"
                        android:background="@drawable/bg_item_play"
                        android:paddingLeft="10.0dip"
                        android:paddingRight="10.0dip"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:foreground="@drawable/fg_efftect_12"
                        android:backgroundTint="#1aeba446">
                        <ImageView
                            android:layout_width="14.0dip"
                            android:layout_height="14.0dip"
                            android:src="@drawable/ic_play_tutorial"
                            android:alpha="0.8"
                            app:tint="#ffeba446" />
                        <TextView
                            android:theme="@style/fontSemi"
                            android:textSize="14.0dip"
                            android:textColor="#ffeba446"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5.0dip"
                            android:text="@string/watch_tutorial"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="start|center"
                android:orientation="horizontal"
                android:id="@id/dialog_optimize_autostart"
                android:background="@drawable/bg_round_12"
                android:paddingLeft="15.0dip"
                android:paddingTop="10.0dip"
                android:paddingRight="15.0dip"
                android:paddingBottom="10.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                android:foreground="@drawable/fg_efftect_12">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <LinearLayout
                        android:gravity="center|left"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="35.0dip"
                            android:layout_height="35.0dip"
                            android:layout_marginRight="10.0dip"
                            android:src="@drawable/ic_autostart_svg" />
                        <TextView
                            android:theme="@style/fontSemi"
                            android:textSize="19.0dip"
                            android:textColor="@color/cl_text_word"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/autostart_title"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <TextView
                        android:textSize="15.0dip"
                        android:textColor="@color/cl_text_word"
                        android:id="@id/dialog_optimize_tv_autostart_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8.0dip"
                        android:layout_marginTop="8.0dip"
                        android:text="@string/autostart_detail"
                        android:lineSpacingExtra="2.0dip" />
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="left"
                        android:orientation="horizontal"
                        android:id="@id/dialog_optimize_ll_autostart_tutorial"
                        android:background="@drawable/bg_item_play"
                        android:paddingLeft="10.0dip"
                        android:paddingRight="10.0dip"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:foreground="@drawable/fg_efftect_12"
                        android:backgroundTint="#195ab88b">
                        <ImageView
                            android:layout_width="14.0dip"
                            android:layout_height="14.0dip"
                            android:src="@drawable/ic_play_tutorial"
                            android:alpha="0.8"
                            app:tint="#ff5ab88b" />
                        <TextView
                            android:theme="@style/fontSemi"
                            android:textSize="14.0dip"
                            android:textColor="#ff5ab88b"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5.0dip"
                            android:text="@string/watch_tutorial"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:padding="2.0dip"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:src="@drawable/ic_more_down"
                    android:rotation="-90.0" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/dialog_optimize_quickstart"
                android:padding="5.0dip"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20.0dip"
                android:layout_marginBottom="20.0dip"
                android:foreground="@drawable/fg_efftect_12">
                <TextView
                    android:theme="@style/fontSemi"
                    android:textSize="16.0dip"
                    android:textColor="@color/cl_rating_app_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_tile_tip_title" />
                <TextView
                    android:textSize="14.0dip"
                    android:textColor="@color/cl_rating_app_name"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10.0dip"
                    android:layout_marginRight="10.0dip"
                    android:text="@string/quick_tile_tip_desc" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>