<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="#ff000000"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.recognize_text.translate.screen.domain.main.fragments.translate_fragment.crop_image.SimpleCropImageView
        android:id="@id/cropView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="90.0dip" />
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="20.0dip"
        android:paddingRight="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="60.0dip"
        android:layout_marginBottom="30.0dip"
        android:paddingHorizontal="20.0dip">
        <TextView
            android:theme="@style/fontBold"
            android:textSize="16.0sp"
            android:textColor="#ffffffff"
            android:gravity="center_vertical"
            android:id="@id/tvCancel"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:text="Cancel"
            android:layout_weight="1.0" />
        <TextView
            android:theme="@style/fontBold"
            android:textSize="16.0sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/tvDone"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="Done" />
    </LinearLayout>
</FrameLayout>